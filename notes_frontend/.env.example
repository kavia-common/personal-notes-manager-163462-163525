# Notes Frontend configuration
# Base URL for the Notes REST API (e.g. http://localhost:8000)
NOTES_API_BASE_URL=http://localhost:8000
# Public site URL for email redirects and absolute links (e.g. http://localhost:3000)
SITE_URL=http://localhost:3000
# Session secret used to sign cookies (set a strong random value in production)
SESSION_SECRET=please-change-me
